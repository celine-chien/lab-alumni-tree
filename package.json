{
  "name": "lab-alumni-tree",
  "private": true,
  "version": "0.1.0",
  "description": "實驗室校友族譜網站",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @vsp/api --filter @vsp/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm --filter @vsp/web build && pnpm --filter @vsp/infra deploy",
    "secrets:init": "pnpm --filter @vsp/scripts init-secrets",
    "import": "pnpm --filter @vsp/scripts import",
    "export": "pnpm --filter @vsp/scripts export",
    "backup": "pnpm --filter @vsp/scripts backup",
    "admin": "pnpm --filter @vsp/scripts admin"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/celine-chien/lab-alumni-tree.git"
  }
}
