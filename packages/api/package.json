{
  "name": "@vsp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./store": "./src/store/index.ts",
    "./blobs": "./src/blobs/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
