    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1142.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-ssm": "^3.1142.0",
    "@aws-sdk/lib-dynamodb": "^3.1142.0",
    "@hono/node-server": "^2.1.1",
    "@vsp/shared": "workspace:*",
    "hono": "^4.13.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT"
}
